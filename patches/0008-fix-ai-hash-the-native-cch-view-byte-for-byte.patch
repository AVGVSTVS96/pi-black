index f1e6440b..4b1c01c0 100644
--- a/packages/ai/src/api/anthropic-claude-code.ts
+++ b/packages/ai/src/api/anthropic-claude-code.ts
@@ -91,10 +91,7 @@ function firstUserPrompt(messages: Message[]): string {
 	for (const message of messages) {
 		if (message.role !== "user") continue;
 		if (typeof message.content === "string") return message.content;
-		return message.content
