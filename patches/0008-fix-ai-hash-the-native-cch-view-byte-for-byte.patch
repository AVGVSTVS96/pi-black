From b47e4c6feb7a2ac380b0731b189457d459cb5760 Mon Sep 17 00:00:00 2001
From: Pi OAuth Compatibility Maintainers <noreply@example.invalid>
Date: Sat, 21 Nov 2026 21:51:21 -0800
Subject: [PATCH] fix(ai): hash the native cch view byte-for-byte

---
 packages/ai/src/api/anthropic-claude-code.ts  | 157 +++++++++++++++++-
 .../ai/test/anthropic-claude-code.test.ts     |  40 +++++
 2 files changed, 189 insertions(+), 8 deletions(-)

diff --git a/packages/ai/src/api/anthropic-claude-code.ts b/packages/ai/src/api/anthropic-claude-code.ts
index f1e6440b..1ee409f9 100644
--- a/packages/ai/src/api/anthropic-claude-code.ts
+++ b/packages/ai/src/api/anthropic-claude-code.ts
@@ -116,6 +116,154 @@ export async function buildClaudeCodeBillingHeader(messages: Message[]): Promise
 	return `x-anthropic-billing-header: cc_version=${CLAUDE_CODE_VERSION}.${fingerprint}; cc_entrypoint=${CLAUDE_CODE_ENTRYPOINT}; ${CCH_PLACEHOLDER};`;
 }
 
+const CCH_EXCLUDED_KEYS = new Set([
+	'"max_tokens"',
+	'"fallbacks"',
+	'"fallback_credit_token"',
+]);
+
+// Byte-level hash view matching the claude-code native engine (validated against
+// claude-code 2.1.220-2.1.295 wire samples): every "model" key whose value is a
+// string is emptied at any depth; max_tokens/fallbacks/fallback_credit_token
+// members are dropped from the view with the native comma rules (a trailing run
+// of two or more excluded members keeps the preceding comma). Everything else
+// stays byte-identical, so unusual escapes or number spellings never change the
+// hash.
+function cchHashInput(body: string): string {
+	const edits: Array<{ start: number; end: number }> = [];
+	let pos = 0;
+	const skipWhitespace = () => {
+		while (pos < body.length && " \t\r\n".includes(body[pos])) pos++;
+	};
+	const consume = (character: string) => {
+		if (body[pos] === character) {
+			pos++;
+			return true;
+		}
+		return false;
+	};
+	const parseString = (): [number, number] => {
+		const start = pos;
+		pos++;
+		while (pos < body.length) {
+			if (body[pos] === "\\") pos += 2;
+			else if (body[pos] === "\"") {
+				pos++;
+				return [start, pos];
+			} else pos++;
+		}
+		throw new Error("Claude Code cch input has an unterminated JSON string");
+	};
+	const parseValue = (collect: boolean): void => {
+		skipWhitespace();
+		if (body[pos] === "{") return parseObject(collect);
+		if (body[pos] === "[") {
+			pos++;
+			skipWhitespace();
+			if (consume("]")) return;
+			for (;;) {
+				parseValue(collect);
+				skipWhitespace();
+				if (consume(",")) continue;
+				if (consume("]")) return;
+				throw new Error("Claude Code cch input has invalid array syntax");
+			}
+		}
+		if (body[pos] === "\"") {
+			parseString();
+			return;
+		}
+		const start = pos;
+		while (pos < body.length && !",}] \t\r\n".includes(body[pos])) pos++;
+		if (pos === start)
+			throw new Error("Claude Code cch input has an invalid JSON value");
+	};
+	function parseObject(collect: boolean): void {
+		pos++;
+		skipWhitespace();
+		if (consume("}")) return;
+		const members: Array<{
+			start: number;
+			end: number;
+			commaBefore: number;
+			commaAfter: number;
+			excluded: boolean;
+		}> = [];
+		let commaBefore = -1;
+		for (;;) {
+			skipWhitespace();
+			const memberStart = pos;
+			const [keyStart, keyEnd] = parseString();
+			skipWhitespace();
+			if (!consume(":"))
+				throw new Error("Claude Code cch input is missing an object colon");
+			skipWhitespace();
+			const key = body.slice(keyStart, keyEnd);
+			const excluded = collect && CCH_EXCLUDED_KEYS.has(key);
+			if (collect && key === '"model"' && body[pos] === "\"") {
+				const [valueStart, valueEnd] = parseString();
+				edits.push({ start: valueStart + 1, end: valueEnd - 1 });
+			} else parseValue(collect && !excluded);
+			const memberEnd = pos;
+			skipWhitespace();
+			let commaAfter = -1;
+			if (consume(",")) commaAfter = pos - 1;
+			members.push({
+				start: memberStart,
+				end: memberEnd,
+				commaBefore,
+				commaAfter,
+				excluded,
+			});
+			if (commaAfter >= 0) {
+				commaBefore = commaAfter;
+				continue;
+			}
+			if (!consume("}"))
+				throw new Error("Claude Code cch input is missing an object end");
+			break;
+		}
+		if (collect) {
+			let index = 0;
+			while (index < members.length) {
+				if (!members[index].excluded) {
+					index++;
+					continue;
+				}
+				let last = index;
+				while (last + 1 < members.length && members[last + 1].excluded)
+					last++;
+				if (last + 1 < members.length)
+					edits.push({
+						start: members[index].start,
+						end: members[last].commaAfter + 1,
+					});
+				else if (index > 0 && last > index)
+					edits.push({ start: members[index].start, end: members[last].end });
+				else if (index > 0)
+					edits.push({
+						start: members[index].commaBefore,
+						end: members[last].end,
+					});
+				else
+					edits.push({ start: members[index].start, end: members[last].end });
+				index = last + 1;
+			}
+		}
+	}
+	parseValue(true);
+	skipWhitespace();
+	if (pos !== body.length)
+		throw new Error("Claude Code cch input has trailing JSON data");
+	edits.sort((a, b) => a.start - b.start);
+	let normalized = "";
+	let cursor = 0;
+	for (const edit of edits) {
+		normalized += body.slice(cursor, edit.start);
+		cursor = edit.end;
+	}
+	return normalized + body.slice(cursor);
+}
 export function patchClaudeCodeCch(serializedBody: string): string {
 	let body: Record<string, unknown>;
 	try {
@@ -137,14 +285,7 @@ export function patchClaudeCodeCch(serializedBody: string): string {
 		if (/; cch=[0-9a-f]{5};$/u.test(billingBlock.text)) return serializedBody;
 		throw new Error("Claude Code OAuth request has an invalid cch billing value");
 	}
-	if (typeof body.model !== "string" || !("max_tokens" in body)) {
-		throw new Error("Claude Code OAuth request is missing model or max_tokens");
-	}
-
-	const normalized = structuredClone(body);
-	normalized.model = "";
-	delete normalized.max_tokens;
-	const hash = xxHash64(new TextEncoder().encode(JSON.stringify(normalized)), CCH_SEED);
+	const hash = xxHash64(new TextEncoder().encode(cchHashInput(serializedBody)), CCH_SEED);
 	const cch = (hash & 0xfffffn).toString(16).padStart(5, "0");
 	billingBlock.text = billingBlock.text.replace(CCH_PLACEHOLDER, `cch=${cch}`);
 	return JSON.stringify(body);
diff --git a/packages/ai/test/anthropic-claude-code.test.ts b/packages/ai/test/anthropic-claude-code.test.ts
index d966ebd0..3bbbfb5b 100644
--- a/packages/ai/test/anthropic-claude-code.test.ts
+++ b/packages/ai/test/anthropic-claude-code.test.ts
@@ -72,4 +72,44 @@ describe("Claude Code Anthropic request compatibility", () => {
 		expect(headers.get("x-client-request-id")).toMatch(/^[0-9a-f-]{36}$/);
 		expect(headers.get("authorization")).toBe("Bearer secret");
 	});
+
+	it("matches native cch oracle values for tool and fallback bodies", () => {
+		const billing =
+			"x-anthropic-billing-header: cc_version=2.1.258.01c; cc_entrypoint=sdk-cli; cch=00000;";
+		const billingCli =
+			"x-anthropic-billing-header: cc_version=2.1.295.8a8; cc_entrypoint=cli; cch=00000;";
+		const sdk = "You are a Claude agent, built on Anthropic's Claude Agent SDK.";
+		const withTools = JSON.stringify({
+			model: "claude-sonnet-4-5",
+			max_tokens: 512,
+			system: [
+				{ type: "text", text: billing },
+				{ type: "text", text: sdk },
+			],
+			messages: [{ role: "user", content: [{ type: "text", text: "oracle b1" }] }],
+			tools: [
+				{
+					name: "Bash",
+					description: "run commands",
+					input_schema: { type: "object", properties: { command: { type: "string" } }, required: ["command"] },
+					eager_input_streaming: true,
+				},
+				{ type: "advisor_20260301", name: "advisor", model: "claude-opus-5-5", defer_loading: true },
+			],
+			stream: true,
+			metadata: { user_id: '{"device_id":"a","account_uuid":"b","session_id":"c"}' },
+		});
+		expect(JSON.parse(patchClaudeCodeCch(withTools)).system[0].text).toContain("cch=98a40;");
+
+		const withFallbacks = JSON.stringify({
+			model: "claude-sonnet-4-5",
+			messages: [{ role: "user", content: "b" }],
+			fallbacks: [{ model: "a" }],
+			fallback_credit_token: "tok",
+			system: [{ type: "text", text: billingCli }],
+			tools: [{ name: "t", model: "m" }],
+			max_tokens: 64,
+		});
+		expect(JSON.parse(patchClaudeCodeCch(withFallbacks)).system[0].text).toContain("cch=cafd5;");
+	});
 });
